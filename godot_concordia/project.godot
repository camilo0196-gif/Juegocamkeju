; Engine configuration file.
; CONCORDIA - proyecto de prueba de la ciudad (Godot 4.7.2, Forward+). Unidades: metros.

config_version=5

[application]

config/name="Concordia"
config/description="Montaje y prueba de la ciudad de Concordia (exportaciones de Blender)."
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_scene="res://scenes/main.tscn"

[rendering]

renderer/rendering_method="forward_plus"
textures/vram_compression/import_s3tc_bptc=true
occlusion_culling/use_occlusion_culling=true
anti_aliasing/quality/msaa_3d=1


[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[physics]

common/physics_ticks_per_second=60

[navigation]

3d/default_cell_size=0.25
3d/default_cell_height=0.05
3d/merge_rasterizer_cell_scale=0.01
