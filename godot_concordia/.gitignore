# Godot: cache e importaciones (se regeneran al abrir el proyecto)
.godot/
*.import
# Assets copiados por tools/sync_assets.py desde export/ y textures/ del repositorio (ya estan en git alli)
assets/**/*.glb
assets/**/*.png
assets/**/*.jpg
assets/**/*.jpeg
assets/**/*.exr
assets/manifest.json
# Capturas y salidas de prueba generadas
debug/out/*
!debug/out/.gdignore
benchmark_resultados.txt
# Mundo horneado por tools/build_world.gd a partir de los .glb importados (se regenera en cada PC)
world/
verificacion_assets.txt
